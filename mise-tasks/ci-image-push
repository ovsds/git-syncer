#!/usr/bin/env bash
#MISE description="Build the backend runtime image and push it as IMAGE_REGISTRY/IMAGE_NAME:IMAGE_TAG"
set -euo pipefail

echo 'Building and pushing backend image...'
docker buildx build \
  --target runtime \
  --tag "${IMAGE_REGISTRY:?}/${IMAGE_NAME:?}:${IMAGE_TAG:?}" \
  --push \
  backend
